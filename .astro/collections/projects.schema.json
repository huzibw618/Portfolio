{
  "$ref": "#/definitions/projects",
  "definitions": {
    "projects": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "Generative AI & NLP",
            "Robotics & Reinforcement Learning",
            "Computer Vision",
            "Systems / Hardware / Formal Methods",
            "Algorithms & Foundations"
          ]
        },
        "date": {
          "type": "string"
        },
        "techStack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "links": {
          "type": "object",
          "properties": {
            "github": {
              "type": "string",
              "format": "uri"
            },
            "demo": {
              "type": "string",
              "format": "uri"
            },
            "paper": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "category",
        "date",
        "techStack",
        "description"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}