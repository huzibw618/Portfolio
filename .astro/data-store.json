ths":181},[],[],[],{"title":163,"category":65,"date":164,"techStack":179,"description":169,"featured":23,"links":180},[21,166,167,168],{},[],"pid-controller.md","popsign",{"id":183,"data":185,"filePath":195,"digest":196,"rendered":197,"legacyId":206},{"title":186,"category":15,"date":187,"techStack":188,"description":192,"summary":193,"featured":98,"links":194},"PopSign: AI Storybooks for ASL Learning","2025-10",[21,93,189,190,191],"Sentence-BERT","spaCy","Embedding-Gemma","A constrained generative pipeline that writes ASL children's stories with zero lexical errors and auto-grades them across Fountas-Pinnell reading levels.","Designed a generative AI pipeline that authors ASL-constrained children's stories using Gemini — with a custom validation framework that drove lexical constraint violations to zero. Built an NLP evaluation system using Sentence-BERT, spaCy, and readability metrics to auto-classify story difficulty across Fountas-Pinnell levels A–Z, enabling data-driven curriculum design. An embedding-based vocabulary sampler (Embedding-Gemma) generates semantically coherent, level-appropriate word sets for each story.",{},"src/content/projects/popsign.md","37e7fa3caec1217f",{"html":28,"metadata":198},{"headings":199,"localImagePaths":200,"remoteImagePaths":201,"frontmatter":202,"imagePaths":205},[],[],[],{"title":186,"category":15,"date":187,"techStack":203,"description":192,"summary":193,"featured":98,"links":204},[21,93,189,190,191],{},[],"popsign.md","predictive-tracking",{"id":207,"data":209,"filePath":218,"digest":219,"rendered":220,"legacyId":229},{"title":210,"category":211,"date":212,"techStack":213,"description":216,"featured":23,"links":217},"Predictive Object Tracking","Computer Vision","2021-09",[21,211,214,215],"Kalman Filter","State Estimation","Kalman filter-based object tracker that predicts future positions in real time — built as a navigation primitive for autonomous vehicles.",{},"src/content/projects/predictive-tracking.md","6dfec1fe0814df6