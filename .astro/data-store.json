k":81,"description":71,"featured":23,"links":82},[68,69,21,70],{},[],"apf-dqn.md","legal-rag",{"id":85,"data":87,"filePath":100,"digest":101,"rendered":102,"legacyId":111},{"title":88,"category":15,"date":89,"techStack":90,"description":96,"summary":97,"featured":98,"links":99},"Legal Knowledge Graph RAG System","2025-11",[21,91,92,93,94,95],"Neo4j","Graphiti","Gemini","Pydantic","LangChain","A production-grade RAG assistant for immigration case law that outperforms standard retrieval by 15–17% using a 264K-node knowledge graph.","Built an end-to-end legal AI assistant that combines a Neo4j knowledge graph (264K nodes, 506K relationships) with Gemini 2.5 Flash to answer immigration case law questions. Pydantic-driven structured extraction turns raw court opinions into a typed graph — no hallucinated schema, no brittle parsing. Outperforms NaiveRAG and CBR-RAG by 15–17% on faithfulness, with a hybrid retrieval pipeline that blends vector search with Cypher-based multi-hop graph traversal.",true,{},"src/content/projects/legal-rag.md","e80e18e82c9cdfe6",{"html":28,"metadata":103},{"headings":104,"localImagePaths":105,"remoteImagePaths":106,"frontmatter":107,"imagePaths":110},[],[],[],{"title":88,"category":15,"date":89,"techStack":108,"description":96,"summary":97,"featured":98,"links":109},[21,91,92,93,94,95],{},[],"legal-rag.md","optimal-seam",{"id":112,"data":114,"filePath":122,"digest":123,"rendered":124,"legacyId":133},{"title":115,"category":42,"date":116,"techStack":117,"description":120,"featured":23,"links":121},"Optimal Seam Finding","2020-11",[21,118,119],"Dynamic Programming","Image Processing","Dynamic programming algorithm for content-aware image resizing — finds minimal-energy seams so cropped images keep their visual proportions.",{},"src/content/projects/optimal-seam.md","36266d3371ee6893",{"html":28,"metadata":125},{"headings":126,"localImagePaths":127,"remoteImagePaths":128,"frontmatter":129,"imagePaths":132},[],[],[],{"title":115,"category":42,"date