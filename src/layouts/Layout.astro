---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Huzaifah Bin Wasim — Machine Learning Engineer',
  description =
    'Machine learning engineer specializing in generative AI, reinforcement learning, and robotics. Georgia Tech MS CS. Builder of a 264K-node legal knowledge graph RAG system.',
} = Astro.props;

const siteUrl = 'https://huzaifah.dev';
const ogImage = `${siteUrl}/profile.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Huzaifah Bin Wasim" />
    <meta name="theme-color" content="#0a0a0b" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Display face used by the hero + every section heading: preload so the
         swap happens before first paint instead of reflowing after it. -->
    <link
      rel="preload"
      href="/fonts/ClashDisplay-Semibold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Flag motion capability before paint so [data-reveal] can hide safely -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
    </script>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>

    <slot />

    <!-- Reveal-on-scroll. Inline and dependency-free on purpose: it runs the
         moment the HTML is parsed, so [data-reveal] content is never waiting on
         the gsap/ScrollTrigger bundle to arrive over the network. The observer
         fires a viewport-height early, so elements have finished fading in by
         the time you scroll to them. -->
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        var show = function (el, delay) {
          if (delay) el.style.setProperty('--reveal-delay', delay.toFixed(2) + 's');
          el.classList.add('is-revealed');
        };

        if (
          !document.documentElement.classList.contains('motion') ||
          !('IntersectionObserver' in window)
        ) {
          els.forEach(function (el) {
            el.classList.add('is-revealed', 'reveal-done');
          });
          return;
        }

        // Drop the transition + will-change once the fade has played, so the
        // element's own hover transitions (and GSAP tweens) run unimpeded.
        document.addEventListener(
          'transitionend',
          function (e) {
            var el = e.target;
            if (el instanceof Element && el.hasAttribute('data-reveal')) {
              el.classList.add('reveal-done');
            }
          },
          true
        );

        var io = new IntersectionObserver(
          function (entries) {
            var i = 0;
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              io.unobserve(el);
              var delay = parseFloat(el.dataset.revealDelay || '0');
              // Siblings entering together cascade instead of popping at once.
              if (el.hasAttribute('data-reveal-stagger')) delay += i++ * 0.05;
              show(el, delay);
            });
          },
          // A viewport of slack on both sides: content fades in well before you
          // reach it, and anything jumped over by an anchor link still counts.
          { rootMargin: '100% 0px', threshold: 0 }
        );
        els.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>

    <!-- Motion extras: Lenis smooth scroll wired into GSAP ScrollTrigger,
         custom cursor, magnetic buttons. Purely decorative — deferred to idle
         so it never competes with content for bandwidth on first load. -->
    <script>
      const boot = () =>
        import('../scripts/motion').then((m) => m.initMotion());
      'requestIdleCallback' in window
        ? (window as any).requestIdleCallback(boot, { timeout: 1200 })
        : setTimeout(boot, 200);
    </script>
  </body>
</html>
