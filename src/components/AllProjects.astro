---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

interface Props { projects: CollectionEntry<'projects'>[]; }
const { projects } = Astro.props;

const categories = [
  'All',
  'Generative AI & NLP',
  'Robotics & Reinforcement Learning',
  'Computer Vision',
  'Systems / Hardware / Formal Methods',
  'Algorithms & Foundations',
] as const;
---

<section id="projects" class="relative z-10 bg-ink border-t border-ink-line">
  <div class="mx-auto max-w-[1400px] px-5 md:px-10 py-24 md:py-36">
    <p class="kicker mb-4" data-reveal>The Full Archive</p>
    <h2 class="display text-cream text-5xl md:text-7xl mb-10" data-reveal>All projects.</h2>

    <!-- filters -->
    <div class="flex flex-wrap gap-2 mb-12" id="filters" data-reveal>
      {categories.map((cat, i) => (
        <button
          data-filter={cat}
          class:list={[
            'filter-btn font-mono text-xs uppercase tracking-[0.15em] rounded-full px-4 py-2 border transition-colors duration-200',
            i === 0
              ? 'bg-emerald text-ink border-emerald'
              : 'text-cream-dim border-ink-line hover:text-cream hover:border-cream-dim',
          ]}
        >{cat === 'Systems / Hardware / Formal Methods' ? 'Systems / Formal' : cat}</button>
      ))}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>

    <p id="no-results" class="hidden text-center font-mono text-sm text-cream-dim py-16">Nothing here yet.</p>
  </div>
</section>

<script>
  import type { gsap as GSAP } from 'gsap';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.project-card'));
  const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const noResults = document.getElementById('no-results')!;
  const grid = document.getElementById('grid')!;

  // Staggered scroll reveal is handled by the inline [data-reveal] observer in
  // Layout.astro — no ScrollTrigger needed here.

  // Everything below is hover/click-driven, so GSAP is fetched on the first
  // interaction rather than during page load.
  let gsapPromise: Promise<typeof GSAP> | null = null;
  const loadGsap = () => (gsapPromise ??= import('gsap').then((m) => m.gsap));

  // pointer-tracked glow position
  const tilt = !reduced && matchMedia('(hover:hover)').matches;
  cards.forEach((card) => {
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);

      // subtle tilt
      if (!tilt) return;
      const rx = ((e.clientY - r.top) / r.height - 0.5) * -6;
      const ry = ((e.clientX - r.left) / r.width - 0.5) * 6;
      loadGsap().then((gsap) =>
        gsap.to(card, { rotateX: rx, rotateY: ry, transformPerspective: 800, duration: 0.4, ease: 'power2.out' })
      );
    });
    if (tilt) {
      card.addEventListener('pointerleave', () => {
        gsapPromise?.then((gsap) => gsap.to(card, { rotateX: 0, rotateY: 0, duration: 0.5 }));
      });
    }
  });

  // FLIP filtering. The Flip plugin (~14 kB) is only reachable by clicking a
  // filter, so it is imported on first use instead of shipped on load.
  tabs.forEach((tab) => {
    tab.addEventListener('click', async () => {
      const filter = tab.dataset.filter!;
      const [gsap, { Flip }] = await Promise.all([loadGsap(), import('gsap/Flip')]);
      gsap.registerPlugin(Flip);
      tabs.forEach((t) => {
        t.classList.toggle('bg-emerald', t === tab);
        t.classList.toggle('text-ink', t === tab);
        t.classList.toggle('border-emerald', t === tab);
        t.classList.toggle('text-cream-dim', t !== tab);
        t.classList.toggle('border-ink-line', t !== tab);
      });

      const state = Flip.getState(cards);
      // Measured while the old set is still laid out. `absolute: true` below
      // lifts every card out of flow, which would otherwise collapse #grid to
      // zero height mid-tween and yank the section border up over the cards.
      const heightBefore = grid.offsetHeight;
      let visible = 0;
      const shown: HTMLElement[] = [];
      cards.forEach((card) => {
        const show = filter === 'All' || card.dataset.category === filter;
        card.style.display = show ? '' : 'none';
        if (show) { visible++; shown.push(card); }
      });
      noResults.classList.toggle('hidden', visible > 0);
      // Filtering is an explicit action — make every matching card visible even if
      // it was never scroll-revealed (would otherwise stay at opacity:0).
      shown.forEach((card) => card.classList.add('is-revealed', 'reveal-done'));

      if (!reduced) {
        // Read the target height while the new set is still in normal flow.
        const heightAfter = grid.offsetHeight;

        Flip.from(state, {
          duration: 0.55,
          ease: 'power2.inOut',
          scale: true,
          absolute: true,
          onEnter: (els) => gsap.fromTo(els, { opacity: 0, scale: 0.85 }, { opacity: 1, scale: 1, duration: 0.4 }),
          onLeave: (els) => gsap.to(els, { opacity: 0, scale: 0.85, duration: 0.3 }),
        });

        // Pin the grid open and glide it to its new size alongside the cards.
        // Same duration/ease as the Flip so the border tracks the layout, then
        // hand height back to the grid so later resizes reflow normally.
        gsap.fromTo(
          grid,
          { height: heightBefore },
          {
            height: heightAfter,
            duration: 0.55,
            ease: 'power2.inOut',
            overwrite: true,
            onComplete: () => grid.style.removeProperty('height'),
          }
        );
      }
    });
  });
</script>
