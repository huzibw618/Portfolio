---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { title, description, techStack, category, links } = project.data;
---

<article
  class="project-card group relative flex flex-col rounded-xl border border-ink-line bg-ink-soft p-6 overflow-hidden
         transition-[transform,border-color] duration-300 will-change-transform
         hover:border-emerald/40"
  data-category={category}
  data-tilt
  data-reveal
  data-reveal-stagger
>
  <!-- hover glow -->
  <div class="pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300"
       style="background: radial-gradient(400px circle at var(--mx,50%) var(--my,50%), rgba(0,229,153,0.08), transparent 45%)"></div>

  <div class="relative flex items-start justify-between gap-3 mb-4">
    <h3 class="font-display font-semibold text-lg leading-snug text-cream group-hover:text-emerald transition-colors">
      {title}
    </h3>
    {links?.github && (
      <a href={links.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub repository"
         class="shrink-0 text-cream-dim hover:text-emerald transition-colors">
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0022 12.017C22 6.484 17.522 2 12 2z" /></svg>
      </a>
    )}
  </div>

  <p class="relative text-sm text-cream-dim leading-relaxed mb-5 flex-1">{description}</p>

  <ul class="relative flex flex-wrap gap-1.5 mt-auto">
    {techStack.slice(0, 4).map((t) => (
      <li class="font-mono text-xs uppercase tracking-wider text-cream-dim/80 border border-ink-line rounded px-1.5 py-0.5">{t}</li>
    ))}
    {techStack.length > 4 && <li class="font-mono text-xs text-emerald/70 px-1">+{techStack.length - 4}</li>}
  </ul>
</article>
