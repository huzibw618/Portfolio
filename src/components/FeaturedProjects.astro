---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<section id="projects" class="py-20 sm:py-28 border-t border-subtle">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="section-heading mb-3">Featured Projects</h2>
    <p class="text-muted mb-12">A handful of things I'm most proud of.</p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {projects.map((project) => (
        <article class="group relative flex flex-col rounded-2xl border border-subtle bg-surface p-6 sm:p-8 hover:border-accent-300 dark:hover:border-accent-700 transition-colors">
          <!-- Category pill -->
          <span class="tag mb-4 self-start">{project.data.category}</span>

          <h3 class="text-xl font-bold mb-3 group-hover:text-accent-500 transition-colors">
            {project.data.title}
          </h3>

          <p class="text-muted leading-relaxed mb-6 flex-1">
            {project.data.summary}
          </p>

          <!-- Tech stack -->
          <div class="flex flex-wrap gap-2 mb-6">
            {project.data.techStack.map((tech) => (
              <span class="rounded-md bg-[rgb(var(--color-bg))] border border-subtle px-2 py-0.5 text-xs font-medium text-muted">
                {tech}
              </span>
            ))}
          </div>

          <!-- Links -->
          {project.data.links && (
            <div class="flex items-center gap-4 text-sm font-medium">
              {project.data.links.github && (
                <a
                  href={project.data.links.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-accent-500 hover:text-accent-600 transition-colors"
                >
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                  </svg>
                  GitHub
                </a>
              )}
              {project.data.links.demo && (
                <a
                  href={project.data.links.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-accent-500 hover:text-accent-600 transition-colors"
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                  Live Demo
                </a>
              )}
              {project.data.links.paper && (
                <a
                  href={project.data.links.paper}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-accent-500 hover:text-accent-600 transition-colors"
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                  Paper
                </a>
              )}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
