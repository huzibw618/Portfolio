---
// Numbers count up on scroll-in, set in mono.
const stats = [
  { value: 4.0, decimals: 1, prefix: '', suffix: '', label: 'GPA at Georgia Tech' },
  { value: 20, decimals: 0, prefix: '', suffix: '+', label: 'Projects' },
  { value: 1, decimals: 0, prefix: '', suffix: '', label: 'Publications' },
];
---

<section class="relative z-10 bg-ink border-y border-ink-line">
  <div class="mx-auto max-w-[1400px] px-5 md:px-10 py-14 md:py-20">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-x-6 gap-y-10">
      {stats.map((s) => (
        <div class="flex flex-col items-center text-center gap-2" data-reveal>
          <span
            class="font-mono text-4xl md:text-5xl lg:text-6xl text-cream tabular-nums leading-none"
            data-count={s.value}
            data-decimals={s.decimals}
            data-prefix={s.prefix}
            data-suffix={s.suffix}
          >{s.prefix}0{s.suffix}</span>
          <span class="font-mono text-xs uppercase tracking-[0.18em] text-cream-dim">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { whenNear } from '../scripts/near';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const fmt = (el: HTMLElement, v: number) =>
    (el.textContent = `${el.dataset.prefix || ''}${v.toFixed(
      parseInt(el.dataset.decimals || '0', 10)
    )}${el.dataset.suffix || ''}`);

  if (reduced) {
    counters.forEach((el) => fmt(el, parseFloat(el.dataset.count!)));
  } else {
    // GSAP is only pulled in as the stats row approaches the viewport.
    whenNear(counters[0], async () => {
      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);

      counters.forEach((el) => {
        const obj = { v: 0 };
        ScrollTrigger.create({
          trigger: el,
          start: 'top 90%',
          once: true,
          onEnter: () =>
            gsap.to(obj, {
              v: parseFloat(el.dataset.count!),
              duration: 1.6,
              ease: 'power2.out',
              onUpdate: () => fmt(el, obj.v),
            }),
        });
      });
    });
  }
</script>
